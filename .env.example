# LoveCards 环境变量配置
# 复制此文件为 .env 并填写实际值

# 必需：Flask 密钥，用于 session 签名等
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# 数据库配置
DB_DRIVER=mysqldb
DB_USER=lovecard
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lovecard

# Session 过期时间（秒），默认 1800 = 30 分钟
SESSION_LIFETIME=1800
